# JWT signing secret - use a long random string in each environment
JWT_SECRET=your-secret-here

# Database connection string (Postgres/Neon in production).
# Leave unset to use the local SQLite file (backend/database.sqlite).
DATABASE_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-actual-cloud-name
CLOUDINARY_API_KEY=your-actual-key
CLOUDINARY_API_SECRET=your-actual-secret

# Google AI Studio (Gemini) API key for AI flora care recommendations.
# Leave unset to disable the feature (endpoint returns 503).
GEMINI_API_KEY=
# Town council that owns work orders raised by this build (single-estate PoC).
# The seed estate's coordinates are Ang Mo Kio, so work orders raised from it
# belong to Ang Mo Kio TC. Override per deployment - EM Services serves 10 of
# Singapore's 19 town councils.
TOWN_COUNCIL=Ang Mo Kio Town Council
